{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CamFox",
  "version": "0.1.0",
  "identifier": "com.camfox.gui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CamFox",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "resources": ["../sidecar"]
  }
}
